# The harness's settings: copy to .env (git-ignored). Nothing is needed: the
# registries `bare` asks (Recherche d'entreprises, VIES, IANA's RDAP) are open.

# Where the sources' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNISTATE_PLUGINS=../..

# Your own VAT number: sent with the VAT check, VIES then answers a
# consultation number.
OMNISTATE_REQUESTER=
